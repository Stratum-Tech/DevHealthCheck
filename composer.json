{
    "name": "stratum-tech/module-dev-healthcheck",
    "description": "CLI health check command for Magento 2 — environment, deployment, and configuration diagnostics",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "magento/framework": ">=103.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "magento/module-store": "*",
        "magento/module-indexer": "*"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Stratum\\DevHealthCheck\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stratum\\DevHealthCheck\\Test\\": "Test/",
            "Stratum\\DevHealthCheck\\Test\\Stub\\": "Test/Stub/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": false
        }
    },
    "extra": {
        "map": [["*", "Stratum/DevHealthCheck"]]
    }
}
